<?xml version="1.0"?>
<package format="2">
  <name>l150_sdk</name>
  <version>0.1.0</version>
  <description>ROS1 hardware SDK for the L150 tracked mobile base.</description>

  <maintainer email="democles@todo.todo">democles</maintainer>
  <license>TODO</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>roscpp</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf</depend>

  <exec_depend>fdilink_ahrs</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>python3-evdev</exec_depend>
  <exec_depend>rostopic</exec_depend>
  <exec_depend>teleop_twist_joy</exec_depend>

  <export/>
</package>

